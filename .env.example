# Set these in the hosting platform. The Go process does not load .env files automatically.
ADDR=0.0.0.0:8080
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
WEB_DIST=/app/web/dist
APP_SECURE_COOKIE=1
PDF_BROWSER=/usr/bin/chromium
# Optional AI helpers (Ollama Cloud)
OLLAMA_API_KEY=
OLLAMA_MODEL=kimi-k2.6
