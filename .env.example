# Set these in the hosting platform. The Go process does not load .env files automatically.
ADDR=0.0.0.0:8080
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
WEB_DIST=/app/web/dist
APP_SECURE_COOKIE=1
PDF_BROWSER=/usr/bin/chromium
# Optional AI helpers — Typhoon (free, Thai-first). For Ollama instead, leave AI_PROVIDER empty and set OLLAMA_API_KEY/OLLAMA_MODEL
AI_PROVIDER=typhoon
AI_API_KEY=
AI_MODEL=typhoon-v2.5-30b-a3b-instruct
# Emails allowed to open the admin page (comma-separated)
ADMIN_EMAILS=
